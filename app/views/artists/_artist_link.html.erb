<%# locals: (artist_url:) -%>
<tr>
  <td>
    <%= artist_url_icon artist_url %>
    <%= link_to artist_url.unescaped_url_identifier, artist_path(artist_url.artist, search: { artist_url_id: [artist_url.id] }) %>
  </td>
  <td>
    <%= artist_url.site_type == "manual" ? time_ago(artist_url.created_at_on_site) : time_ago(artist_url.last_scraped_at) %>
  </td>
  <td>
    <%= link_to "[U]", enqueue_artist_url_path(artist_url), method: :post, title: "Enqueue scraping" if artist_url.scraper_enabled? %>
  </td>
  <td>
    <% if artist_url.id.in? job_stats.scraping_now %>
      Scraping now: <%= scraper_status(artist_url) %></div>
    <% elsif job_stats.scraping_queued[artist_url.id] %>
      <div title="Scraping queued">⏳</div>
    <% end %>
  </td>
  <td class="align-right" title="<%= artist_url.site_type == "tumblr" ? "Reblogs" : "File downloads" %>">
    <%= job_stats.submission_download_queued[artist_url.id] %>
  </td>
  <td class="align-right">
    <%= job_stats.e6_iqdb_queued[artist_url.id] %>
  </td>
</tr>
