<%# locals: (artist_urls:) -%>
<table class="url-list table full-width">
  <thead>
    <th>Link</th>
    <th>Actions</th>
    <th>Last scraped</th>
    <th>Status</th>
    <th class="align-right">Pending File Downloads</th>
    <th class="align-right">Pending IQDB calls</th>
  </thead>
  <% artist_urls.each do |artist_url| %>
    <tr>
      <td>
        <%= artist_url_icon artist_url %>
        <%= link_to artist_url.unescaped_url_identifier, artist_path(artist_url.artist, search: { artist_url_id: [artist_url.id] }) %>
      </td>
      <td>
        <%= link_to "Enqueue", enqueue_artist_url_path(artist_url), method: :post if artist_url.scraper_enabled? %>
      </td>
      <td>
        <%= artist_url.site_type == "manual" ? time_ago(artist_url.created_at_on_site) : time_ago(artist_url.last_scraped_at) %>
      </td>
      <td><%= scraper_status(artist_url) %></td>
      <td class="align-right">
        <%= job_stats.submission_download_queued[artist_url.id] || 0 %>
        <%= "(Reblogs)" if artist_url.site_type == "tumblr" %>
      </td>
      <td class="align-right">
        <%= job_stats.e6_iqdb_queued[artist_url.id] || 0 %>
      </td>
    </tr>
  <% end %>
</table>
